---
import type { CollectionEntry } from 'astro:content';

import LoreBadge from './LoreBadge.astro';

interface Props {
  entry: CollectionEntry<'forever'>;
  sourceTitles: Record<string, { title: string; url?: string }>;
}

const { entry, sourceTitles } = Astro.props;
const data = entry.data;
---

<article class="forever-change" id={data.id} aria-labelledby={`forever-${data.id}`}>
  <header class="forever-change-header">
    <h2 id={`forever-${data.id}`}>{data.title}</h2>
    <LoreBadge status={data.status} />
  </header>
  <p class="forever-summary">{data.summary}</p>
  <div class="forever-columns">
    <section class="forever-column is-original" aria-label="В первый год оригинального World of Warcraft">
      <p class="section-kicker">Первый год оригинального WoW</p>
      <p>{data.oldExpectation}</p>
    </section>
    <section class="forever-column is-forever" aria-label="В World of Warcraft: Forever">
      <p class="section-kicker">World of Warcraft: Forever</p>
      <p>{data.foreverVersion}</p>
    </section>
  </div>
  <p class="forever-why"><strong>Почему это важно.</strong> {data.whyItMatters}</p>
  {data.sourceNote && <p class="event-date-note"><strong>Об источниках:</strong> {data.sourceNote}</p>}
  <details class="forever-sources">
    <summary>Источники ({data.sourceIds.length})</summary>
    <ul>
      {data.sourceIds.map((id) => (
        <li>{sourceTitles[id]?.url ? <a href={sourceTitles[id].url} rel="noreferrer">{sourceTitles[id].title}</a> : sourceTitles[id]?.title ?? id}</li>
      ))}
    </ul>
  </details>
</article>
