---
import { route } from '../lib/routes';

interface ChapterLink { slug: string; title: string }
interface Props {
  currentId: string;
  previous?: ChapterLink;
  next?: ChapterLink;
}
const { currentId, previous, next } = Astro.props;
---

<nav class="chapter-next" aria-label="Переход между главами" data-completion-id={currentId}>
  <div class="chapter-completion">
    <div>
      <p class="section-kicker">Ваш путь</p>
      <p class="completion-status" data-completion-status role="status">Глава не отмечена</p>
    </div>
    <button type="button" data-complete-chapter data-complete="false">
      <span aria-hidden="true" data-completion-icon>✓</span>
      <span data-completion-label>Отметить главу прочитанной</span>
    </button>
  </div>
  <div class="chapter-links">
    {previous ? <a class="chapter-link previous" href={route(`chapters/${previous.slug}`)}><span>← Предыдущая глава</span><strong>{previous.title}</strong></a> : <span />}
    {next ? <a class="chapter-link next" href={route(`chapters/${next.slug}`)}><span>Следующая глава →</span><strong>{next.title}</strong></a> : <a class="chapter-link next" href={route('start-here')}><span>Путь завершён →</span><strong>Вернуться к маршруту</strong></a>}
  </div>
</nav>

<script>
  // The button toggles, so a mistaken mark can be undone; its label names the next action
  // and the status line announces the current state.
  document.querySelectorAll<HTMLElement>('[data-completion-id]').forEach((navigation) => {
    const chapterId = navigation.dataset.completionId!;
    const button = navigation.querySelector<HTMLButtonElement>('[data-complete-chapter]')!;
    const label = navigation.querySelector<HTMLElement>('[data-completion-label]')!;
    const status = navigation.querySelector<HTMLElement>('[data-completion-status]')!;
    const icon = navigation.querySelector<HTMLElement>('[data-completion-icon]')!;
    const readProgress = (): string[] => {
      try {
        const value: unknown = JSON.parse(localStorage.getItem('wow-reading-progress') || '[]');
        return Array.isArray(value) ? value.filter((id): id is string => typeof id === 'string') : [];
      } catch {
        return [];
      }
    };
    const update = () => {
      const complete = readProgress().includes(chapterId);
      button.dataset.complete = String(complete);
      icon.hidden = complete;
      label.textContent = complete ? 'Снять отметку о прочтении' : 'Отметить главу прочитанной';
      status.textContent = complete ? 'Глава прочитана' : 'Глава не отмечена';
    };
    button.addEventListener('click', () => {
      const current = new Set(readProgress());
      if (current.has(chapterId)) {
        current.delete(chapterId);
      } else {
        current.add(chapterId);
      }
      try {
        localStorage.setItem('wow-reading-progress', JSON.stringify([...current]));
      } catch {
        // Storage can be blocked; the page state still reflects nothing was saved.
      }
      update();
      window.dispatchEvent(new Event('wow:progress-changed'));
    });
    update();
  });
</script>
