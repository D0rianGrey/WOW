---
import EntityCard from '../../components/EntityCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { factionDiagram } from '../../lib/diagrams';
import { dossierLabels, loadDossiers } from '../../lib/dossiers';
import { route } from '../../lib/routes';

const entries = await loadDossiers('factions');
const label = dossierLabels.factions;
---

<BaseLayout title={label.title} description={label.lead}>
  <header class="path-header">
    <p class="eyebrow">Досье</p>
    <h1>{label.title}</h1>
    <p class="lead">{label.lead}</p>
  </header>
  <figure class="dossier-diagram">
    <img src={factionDiagram.src} alt={factionDiagram.alt} width="960" height="520" loading="lazy" decoding="async" />
    <figcaption>{factionDiagram.caption}</figcaption>
  </figure>
  <div class="entity-grid">
    {entries.map((entry) => (
      <EntityCard href={route(`factions/${entry.data.slug}`)} title={entry.data.title} summary={entry.data.summary} status={entry.data.status} />
    ))}
  </div>
</BaseLayout>
