---
import EntityCard from '../../components/EntityCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dossierLabels, loadDossiers } from '../../lib/dossiers';
import { route } from '../../lib/routes';

const entries = await loadDossiers('locations');
const label = dossierLabels.locations;
---

<BaseLayout title={label.title} description={label.lead}>
  <header class="path-header">
    <p class="eyebrow">Досье</p>
    <h1>{label.title}</h1>
    <p class="lead">{label.lead}</p>
  </header>
  <div class="entity-grid">
    {entries.map((entry) => (
      <EntityCard href={route(`locations/${entry.data.slug}`)} title={entry.data.title} summary={entry.data.summary} status={entry.data.status} />
    ))}
  </div>
</BaseLayout>
