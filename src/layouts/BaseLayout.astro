---
import AppShell from '../components/AppShell.astro';
import { route } from '../lib/routes';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/print.css';
interface Props {
  title: string;
  description?: string;
  documentTitle?: string;
  breadcrumbs?: { label: string; href?: string }[];
}
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const socialImage = new URL(route('images/chapters/war-of-the-ancients.webp'), Astro.site).toString();
const { title, description = 'Русскоязычный путеводитель по истории Warcraft и World of Warcraft: Forever с прозрачными статусами лора.', documentTitle = `${title} — Warcraft: Forever`, breadcrumbs } = Astro.props;
---
<!doctype html>
<html lang="ru" data-reading-mode="essential" data-spoilers="hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10151a" />
    <title>{documentTitle}</title>
    <link rel="icon" href={route('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Хроники Азерота" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Well of Eternity под воронкой магии — иллюстрация энциклопедии" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const reading = localStorage.getItem('wow-reading-mode');
        const spoilers = localStorage.getItem('wow-spoilers');
        document.documentElement.dataset.readingMode = reading === 'deep' ? 'deep' : 'essential';
        document.documentElement.dataset.spoilers = spoilers === 'shown' ? 'shown' : 'hidden';
      } catch { /* Defaults are safe when browser storage is unavailable. */ }
    </script>
  </head>
  <body><AppShell title={title} breadcrumbs={breadcrumbs}><slot /></AppShell></body>
</html>
