---
import BaseLayout from './BaseLayout.astro';
import LoreBadge from '../components/LoreBadge.astro';
import type { LoreStatus } from '../lib/status';
interface Props {
  title: string;
  summary?: string;
  status?: LoreStatus;
  eyebrow?: string;
  readingMinutes?: number;
  breadcrumbs?: { label: string; href?: string }[];
}
const { title, summary, status = 'ESTABLISHED', eyebrow = 'Хроники Азерота', readingMinutes, breadcrumbs } = Astro.props;
---
<BaseLayout title={title} description={summary} breadcrumbs={breadcrumbs}>
  <article class="lore-article">
    <header class="chapter-header"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1>{summary && <p class="lead">{summary}</p>}<div class="chapter-meta"><LoreBadge status={status} />{readingMinutes && <span>{readingMinutes} мин · главное</span>}</div></header>
    <div class="prose"><slot /></div>
    <slot name="navigation" />
  </article>
</BaseLayout>
